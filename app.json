{
  "name": "TREND-X V2",
  "description": "I am TREND-X WhatsApp MultiDevice Bot built in NodeJs to enhance the experience.",
  "logo": "https://files.catbox.moe/adymbp.jpg",
  "keywords": ["WhatsApp", "Bot", "TREND-X", "Node.js", "MultiDevice", "Baileys"],
  "repository": "https://github.com/trendex2030/TREND-X",
  "stack": "container",
  "env": {
    "SESSION_ID": {
      "description": "Your session ID (starts with trend-x~...) from MEGA",
      "required": true
    },
    "MODE": {
      "description": "Bot mode: public or self",
      "required": true,
      "value": "public"
    },
    "BOT_NAME": {
      "description": "Customize your bot's name",
      "required": false,
      "value": "TREND-X"
    },
    "MENU_IMAGE": {
      "description": "URL of custom menu image (optional)",
      "required": false,
      "value": "https://files.catbox.moe/adymbp.jpg"
    },
    "DESCRIPTION": {
      "description": "Bot caption and branding text",
      "required": false,
      "value": "© ᴘᴏᴡᴇʀᴇᴅ ʙʏ TRENDEX"
    },
    "ANTI_DELETE": {
      "description": "Anti-delete target path (e.g., inbox, group)",
      "required": true,
      "value": "inbox"
    },
    "ANTI_DELETE_PATH": {
      "description": "Enable anti-delete feature (true/false)",
      "required": true,
      "value": "true"
    },
    "AUTO_STATUS_SEEN": {
      "description": "Auto view WhatsApp status updates",
      "required": false,
      "value": "true"
    },
    "AUTO_STATUS_REPLY": {
      "description": "Auto reply after viewing a status",
      "required": false,
      "value": "false"
    },
    "STATUS_READ_MSG": {
      "description": "Message sent after viewing status",
      "required": false,
      "value": "*Status Seen By TREND-X 👻🤍*"
    },
    "OWNER_NAME": {
      "description": "Owner's name",
      "required": false,
      "value": "TRENDEX"
    },
    "OWNER_NUMBER": {
      "description": "Owner's WhatsApp number (in international format)",
      "required": false,
      "value": "+254734939236"
    },
    "AUTO_READ": {
      "description": "Auto read messages",
      "required": false,
      "value": "false"
    },
    "AUTO_TYPING": {
      "description": "Show typing indicator automatically",
      "required": false,
      "value": "false"
    },
    "AUTO_RECORDING": {
      "description": "Show audio recording status automatically",
      "required": false,
      "value": "false"
    },
    "ALWAYS_ONLINE": {
      "description": "Keep bot always online",
      "required": false,
      "value": "false"
    },
    "AUTO_BLOCK": {
      "description": "Auto block +212 spam numbers",
      "required": false,
      "value": "false"
    },
    "REJECT_CALL": {
      "description": "Reject incoming WhatsApp calls",
      "required": false,
      "value": "false"
    },
    "PREFIX": {
      "description": "Command prefix used to trigger bot",
      "required": false,
      "value": "."
    }
  },
  "buildpacks": [
    {
      "url": "heroku/nodejs"
    },
    {
      "url": "https://github.com/DuckyTeam/heroku-buildpack-imagemagick.git"
    },
    {
      "url": "https://github.com/jonathanong/heroku-buildpack-ffmpeg-latest"
    },
    {
      "url": "https://github.com/clhuang/heroku-buildpack-webp-binaries.git"
    }
  ]
}
